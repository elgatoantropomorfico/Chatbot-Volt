generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  superadmin
  tenant_admin
  agent
}

enum TenantStatus {
  active
  inactive
  suspended
}

enum ChannelProvider {
  whatsapp_cloud
}

enum LeadStage {
  nuevo
  contactado
  interesado
  venta
  perdido
}

enum ConversationStatus {
  open
  pending_human
  closed
}

enum MessageDirection {
  in
  out
  system
}

enum IntegrationType {
  woocommerce
  zoho_crm
  pilot_crm
  mercadopago
  resend
}

enum AppointmentStatus {
  pendiente_datos
  pendiente_pago
  confirmado
  cancelado
  reprogramado
  completado
  no_asistio
  vencido
}

enum IntegrationStatus {
  active
  inactive
  error
}

enum IntentLevel {
  low
  medium
  high
}

enum ZohoSyncStatus {
  pending
  synced
  error
}

enum PilotSyncStatus {
  pending
  synced
  error
  needs_update
}

enum SaleStatus {
  pending
  completed
  cancelled
}

enum LeadRequestStatus {
  in_progress
  completed
  cancelled
}

// ============================================
// MODELS
// ============================================

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String?
  passwordHash  String     @map("password_hash")
  role          UserRole   @default(agent)
  tenantId      String?    @map("tenant_id")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  tenant        Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedLeads Lead[]     @relation("AssignedAgent")
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Tenant {
  id          String       @id @default(cuid())
  name        String
  displayName String?      @map("display_name")
  status      TenantStatus @default(active)
  timezone  String       @default("America/Argentina/Buenos_Aires")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  users         User[]
  channels      Channel[]
  leads         Lead[]
  conversations Conversation[]
  botSettings   BotSettings?
  integrations  Integration[]
  sales         Sale[]
  eventsOutbox  EventOutbox[]
  offers            TenantOffer[]
  zohoFieldConfigs  ZohoFieldConfig[]
  pilotFieldConfigs PilotFieldConfig[]
  leadFieldConfigs  LeadFieldConfig[]
  leadRequests      LeadRequest[]
  bookingSettings   BookingSettings?
  bookingServices   BookingService[]
  bookingSlots      BookingSlot[]
  bookingBlocks     BookingBlock[]
  bookingPriceRules BookingPriceRule[]
  appointments      Appointment[]

  @@map("tenants")
}

model Channel {
  id             String          @id @default(cuid())
  tenantId       String          @map("tenant_id")
  provider       ChannelProvider @default(whatsapp_cloud)
  phoneNumberId  String          @unique @map("phone_number_id")
  wabaId         String          @map("waba_id")
  displayPhone   String?         @map("display_phone")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads          Lead[]
  conversations  Conversation[]

  @@map("channels")
}

model Lead {
  id                  String          @id @default(cuid())
  tenantId            String          @map("tenant_id")
  channelId           String?         @map("channel_id")

  phone               String
  whatsappProfileName String?         @map("whatsapp_profile_name")

  name                String?
  firstName           String?         @map("first_name")
  lastName            String?         @map("last_name")
  fullName            String?         @map("full_name")

  email               String?
  dni                 String?

  offerInterest       String?         @map("offer_interest")
  modalityInterest    String?         @map("modality_interest")
  periodInterest      String?         @map("period_interest")

  stage               LeadStage       @default(nuevo)
  intentLevel         IntentLevel?    @map("intent_level")
  lastDetectedTopic   String?         @map("last_detected_topic")
  needsHumanFollowup  Boolean         @default(false) @map("needs_human_followup")

  customData          Json?           @map("custom_data")

  zohoContactId       String?         @map("zoho_contact_id")
  zohoSyncStatus      ZohoSyncStatus  @default(pending) @map("zoho_sync_status")
  zohoLastSyncAt      DateTime?       @map("zoho_last_sync_at")
  zohoLastError       String?         @map("zoho_last_error")
  zohoSyncHash        String?         @map("zoho_sync_hash")

  pilotContactId      String?         @map("pilot_contact_id")
  pilotSyncStatus     PilotSyncStatus @default(pending) @map("pilot_sync_status")
  pilotLastSyncAt     DateTime?       @map("pilot_last_sync_at")
  pilotLastError      String?         @map("pilot_last_error")
  pilotSyncHash       String?         @map("pilot_sync_hash")

  assignedUserId      String?         @map("assigned_user_id")
  lastMessageAt       DateTime?       @map("last_message_at")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel             Channel?        @relation(fields: [channelId], references: [id])
  assignedUser        User?           @relation("AssignedAgent", fields: [assignedUserId], references: [id])
  conversations       Conversation[]
  notes               LeadNote[]
  sales               Sale[]
  photos              LeadPhoto[]
  requests            LeadRequest[]
  appointments        Appointment[]

  @@unique([tenantId, phone])
  @@index([tenantId, zohoContactId])
  @@index([tenantId, pilotContactId])
  @@map("leads")
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String   @map("lead_id")
  authorId  String?  @map("author_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("lead_notes")
}

model Conversation {
  id              String             @id @default(cuid())
  tenantId        String             @map("tenant_id")
  leadId          String             @map("lead_id")
  channelId       String             @map("channel_id")
  status          ConversationStatus @default(open)
  summary         String?
  handoffReason   String?            @map("handoff_reason")
  handoffAt       DateTime?          @map("handoff_at")
  isArchived      Boolean            @default(false) @map("is_archived")
  bookingFlowJson Json?              @map("booking_flow_json")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead            Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  channel         Channel            @relation(fields: [channelId], references: [id])
  messages        Message[]
  appointments    Appointment[]

  @@map("conversations")
}

model Message {
  id                String           @id @default(cuid())
  conversationId    String           @map("conversation_id")
  direction         MessageDirection
  text              String
  messageType       String           @default("text") @map("message_type")
  mediaUrl          String?          @map("media_url")
  providerMessageId String?          @map("provider_message_id")
  createdAt         DateTime         @default(now()) @map("created_at")

  conversation      Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model BotSettings {
  tenantId                String   @id @map("tenant_id")
  systemPrompt            String   @default("Eres un asistente virtual amable y profesional.") @map("system_prompt")
  model                   String   @default("gpt-4o-mini")
  temperature             Float    @default(0.7)
  maxContextMessages      Int      @default(15) @map("max_context_messages")
  handoffEnabled          Boolean  @default(true) @map("handoff_enabled")
  handoffPhoneE164        String?  @map("handoff_phone_e164")
  handoffMessageTemplate  String?  @default("Te derivo con un asesor: {{wa_me_link}}") @map("handoff_message_template")
  handoffWaMeTemplate     String?  @map("handoff_wa_me_template")
  handoffTriggersJson     Json?    @map("handoff_triggers_json")
  guardrailsJson          Json?    @map("guardrails_json")
  promptBuilderJson       Json?    @map("prompt_builder_json")
  bookingNotifyEnabled    Boolean  @default(false) @map("booking_notify_enabled")
  bookingNotifyEmail      String?  @map("booking_notify_email")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  tenant                  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("bot_settings")
}

model Integration {
  id              String            @id @default(cuid())
  tenantId        String            @map("tenant_id")
  type            IntegrationType
  configEncrypted String            @map("config_encrypted")
  status          IntegrationStatus @default(inactive)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type])
  @@map("integrations")
}

model Sale {
  id               String     @id @default(cuid())
  tenantId         String     @map("tenant_id")
  leadId           String     @map("lead_id")
  conversationId   String?    @map("conversation_id")
  status           SaleStatus @default(pending)
  totalAmount      Float      @map("total_amount")
  currency         String     @default("ARS")
  checkoutMode     String     @default("wa_human") @map("checkout_mode")
  customerName     String?    @map("customer_name")
  customerPhone    String?    @map("customer_phone")
  itemsJson        Json       @map("items_json")
  notes            String?
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  tenant           Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead             Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("sales")
}

model TenantOffer {
  id                String   @id @default(cuid())
  tenantId          String   @map("tenant_id")
  name              String
  slug              String
  zohoPicklistValue String   @map("zoho_picklist_value")
  synonymsJson      Json?    @map("synonyms_json")
  keywordsJson      Json?    @map("keywords_json")
  description       String?
  isActive          Boolean  @default(true) @map("is_active")
  sortOrder         Int      @default(0) @map("sort_order")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId, isActive])
  @@map("tenant_offers")
}

model PilotFieldConfig {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  localKey       String   @map("local_key")
  pilotField     String   @map("pilot_field")
  label          String
  fieldType      String   @default("text") @map("field_type")
  isRequired     Boolean  @default(false) @map("is_required")
  isActive       Boolean  @default(true) @map("is_active")
  sortOrder      Int      @default(0) @map("sort_order")
  defaultValue   String?  @map("default_value")
  includeInNotes Boolean  @default(false) @map("include_in_notes")
  optionsJson    Json?    @map("options_json")
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, localKey])
  @@map("pilot_field_configs")
}

model ZohoFieldConfig {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  localKey    String   @map("local_key")
  zohoField   String   @map("zoho_field")
  label       String
  fieldType   String   @default("single_line") @map("field_type")
  isRequired  Boolean  @default(false) @map("is_required")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  fixedValue  String?  @map("fixed_value")
  optionsJson Json     @default("[]") @map("options_json")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, localKey])
  @@index([tenantId])
  @@map("zoho_field_configs")
}

model LeadFieldConfig {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  fieldKey    String   @map("field_key")
  label       String
  fieldType   String   @default("text") @map("field_type")
  scope       String   @default("request")
  step        Int      @default(1)
  isRequired  Boolean  @default(false) @map("is_required")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  optionsJson Json     @default("[]") @map("options_json")
  promptHint  String?  @map("prompt_hint")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, fieldKey])
  @@index([tenantId])
  @@map("lead_field_configs")
}

// A LeadRequest represents one "pedido" inside a lead — a turno (CardioCor)
// or a presupuesto (TallerAlfa). A lead can accumulate many requests over
// time, each with its own captured data and photos.
model LeadRequest {
  id          String            @id @default(cuid())
  tenantId    String            @map("tenant_id")
  leadId      String            @map("lead_id")
  status      LeadRequestStatus @default(in_progress)
  data        Json              @default("{}")
  label       String?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  completedAt DateTime?         @map("completed_at")

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead        Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  photos      LeadPhoto[]

  @@index([leadId, status])
  @@index([tenantId])
  @@map("lead_requests")
}

model LeadPhoto {
  id         String       @id @default(cuid())
  leadId     String       @map("lead_id")
  requestId  String?      @map("request_id")
  fieldKey   String       @map("field_key")
  url        String
  mimeType   String?      @map("mime_type")
  fileSize   Int?         @map("file_size")
  caption    String?
  createdAt  DateTime     @default(now()) @map("created_at")

  lead       Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  request    LeadRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([leadId, fieldKey])
  @@index([requestId])
  @@map("lead_photos")
}

model EventOutbox {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  eventType  String   @map("event_type")
  payload    Json
  processed  Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([processed, createdAt])
  @@map("events_outbox")
}

// ============================================
// BOOKING / TURNERA (El Gabinete, etc.)
// ============================================

model BookingSettings {
  tenantId                     String   @id @map("tenant_id")
  bookingEnabled               Boolean  @default(false) @map("booking_enabled")
  bookingMode                  String   @default("fixed_slots") @map("booking_mode")
  sessionDurationMinutes       Int      @default(80) @map("session_duration_minutes")
  slotIntervalMinutes          Int      @default(90) @map("slot_interval_minutes")
  bufferMinutes                Int      @default(10) @map("buffer_minutes")
  timezone                     String   @default("America/Argentina/Cordoba")
  currency                     String   @default("ARS")
  priceMode                    String   @default("same_price_for_all_services") @map("price_mode")
  basePrice                    Decimal? @map("base_price") @db.Decimal(12, 2)
  depositEnabled               Boolean  @default(true) @map("deposit_enabled")
  depositPercentage            Int      @default(50) @map("deposit_percentage")
  depositRefundable            Boolean  @default(false) @map("deposit_refundable")
  allowFullPayment             Boolean  @default(true) @map("allow_full_payment")
  paymentLinkExpirationMinutes Int      @default(15) @map("payment_link_expiration_minutes")
  workingDaysJson              Json     @default("[1,2,3,4,5]") @map("working_days_json")
  cancellationPolicyJson       Json?    @map("cancellation_policy_json")
  messagesJson                 Json?    @map("messages_json")
  allowCustomSlots             Boolean  @default(true) @map("allow_custom_slots")
  allowCustomServices          Boolean  @default(true) @map("allow_custom_services")
  cancelEnabled                Boolean  @default(true) @map("cancel_enabled")
  createdAt                    DateTime @default(now()) @map("created_at")
  updatedAt                    DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("booking_settings")
}

model BookingService {
  id                   String   @id @default(cuid())
  tenantId             String   @map("tenant_id")
  slug                 String
  name                 String
  serviceType          String?  @map("service_type")
  shortDescription     String?  @map("short_description")
  longDescription      String?  @map("long_description")
  durationMinutes      Int      @default(80) @map("duration_minutes")
  price                Decimal? @db.Decimal(12, 2)
  usesBasePrice        Boolean  @default(true) @map("uses_base_price")
  isActive             Boolean  @default(true) @map("is_active")
  sortOrder            Int      @default(0) @map("sort_order")
  recommendationTags   Json     @default("[]") @map("recommendation_tags")
  recommendedWhen      Json     @default("[]") @map("recommended_when")
  botSummary           String?  @map("bot_summary")
  botRecommendationText String? @map("bot_recommendation_text")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([tenantId, slug])
  @@index([tenantId, isActive])
  @@map("booking_services")
}

model BookingSlot {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  time            String
  durationMinutes Int      @default(80) @map("duration_minutes")
  isActive        Boolean  @default(true) @map("is_active")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, time])
  @@index([tenantId, isActive])
  @@map("booking_slots")
}

model BookingBlock {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  date      DateTime @db.Date
  time      String?
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, date])
  @@map("booking_blocks")
}

model BookingPriceRule {
  id         String    @id @default(cuid())
  tenantId   String    @map("tenant_id")
  label      String
  ruleType   String    @map("rule_type")
  value      Decimal   @db.Decimal(12, 2)
  validFrom  DateTime? @map("valid_from")
  validUntil DateTime? @map("valid_until")
  isActive   Boolean   @default(true) @map("is_active")
  sortOrder  Int       @default(0) @map("sort_order")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([tenantId, isActive])
  @@map("booking_price_rules")
}

model Appointment {
  id               String            @id @default(cuid())
  tenantId         String            @map("tenant_id")
  leadId           String            @map("lead_id")
  conversationId   String?           @map("conversation_id")
  serviceId        String            @map("service_id")
  customerName     String?           @map("customer_name")
  customerPhone    String            @map("customer_phone")
  appointmentDate  DateTime          @map("appointment_date") @db.Date
  appointmentTime  String            @map("appointment_time")
  status           AppointmentStatus @default(pendiente_datos)
  listPrice        Decimal           @map("list_price") @db.Decimal(12, 2)
  finalPrice       Decimal           @map("final_price") @db.Decimal(12, 2)
  priceRuleId      String?           @map("price_rule_id")
  discountLabel    String?           @map("discount_label")
  amountTotal      Decimal           @map("amount_total") @db.Decimal(12, 2)
  amountPaid       Decimal           @default(0) @map("amount_paid") @db.Decimal(12, 2)
  balanceDue       Decimal           @default(0) @map("balance_due") @db.Decimal(12, 2)
  paymentType      String?           @map("payment_type")
  mpPreferenceId   String?           @map("mp_preference_id")
  mpPaymentId      String?           @map("mp_payment_id")
  mpStatus         String?           @map("mp_status")
  mpPaymentLink    String?           @map("mp_payment_link")
  receiptToken     String?           @unique @map("receipt_token")
  customerNotes    String?           @map("customer_notes")
  isFirstTime      Boolean?          @map("is_first_time")
  holdExpiresAt    DateTime?         @map("hold_expires_at")
  confirmedAt      DateTime?         @map("confirmed_at")
  cancelledAt      DateTime?         @map("cancelled_at")
  completedAt      DateTime?         @map("completed_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead         Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  conversation Conversation?     @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  service      BookingService    @relation(fields: [serviceId], references: [id])
  priceRule    BookingPriceRule? @relation(fields: [priceRuleId], references: [id], onDelete: SetNull)

  @@index([tenantId, appointmentDate, appointmentTime])
  @@index([tenantId, status])
  @@index([leadId])
  @@map("appointments")
}
